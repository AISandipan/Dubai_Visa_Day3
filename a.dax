filter by date =
VAR JoinDate = DATE ( "2019", "7", "19" )
var ret = if(tbl_emp[Date of Joining].[Date] == JoinDate, True,False)
return ret

Total Proposals by DateType = 
SWITCH(
    [SelectedDateType],
    
    "Project Date", 
        CALCULATE(
            COUNT(RAWDATA[Proposal Name]),
            USERELATIONSHIP('CALENDAR'[Date], RAWDATA[RAWDATA_ProjectDate])
        ),

    "Assessment Closure Date", 
        CALCULATE(
            COUNT(RAWDATA[Proposal Name]),
            USERELATIONSHIP('CALENDAR'[Date], RAWDATA[RAWDATA_AssessmentClosureDate])
        ),

    "RFA Date", 
        CALCULATE(
            COUNT(RAWDATA[Proposal Name]),
            USERELATIONSHIP('CALENDAR'[Date], RAWDATA[RAWDATA_RFADate])
        ),

    "Closure Date",
        CALCULATE(
            COUNT(RAWDATA[Proposal Name]),
            USERELATIONSHIP('CALENDAR'[Date], RAWDATA[RAWDATA_ClosureDate])
        )
)
