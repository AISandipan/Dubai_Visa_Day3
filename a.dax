Highest_Lowest1 = 

VAR CurrentSale=SUM(Orders1[Sales])

VAR HSale=MAXX(

    ALLSELECTED(Orders1[Sub-Category]),
    CALCULATE(SUM(Orders1[Sales]))
)

VAR LSale=MINX(

    ALLSELECTED(Orders1[Sub-Category]),
    CALCULATE(SUM(Orders1[Sales]))

)

RETURN
IF(

    CurrentSale=HSale,"#3df50bff",
    IF(
        CurrentSale=LSale,"#fb2743ff",
        "#1cd1e9ff"



    )
)









